{
  "version": "1.0",
  "id": "data-extraction",
  "name": "Data extraction & chaining",
  "description": "Capture a value from one response and reuse it in later requests.",
  "rootFolder": {
    "id": "root",
    "name": "root",
    "description": "",
    "folders": [
      {
        "id": "folder-data-extraction",
        "name": "Data extraction & chaining",
        "description": "",
        "folders": [],
        "requestIds": [
          "login",
          "use-token"
        ]
      }
    ],
    "requestIds": []
  },
  "requests": {
    "login": {
      "id": "login",
      "name": "Login (extract token)",
      "method": "POST",
      "url": "https://api.practicesoftwaretesting.com/users/login",
      "headers": [],
      "params": [],
      "auth": {
        "type": "none"
      },
      "body": {
        "mode": "json",
        "json": "{\"email\":\"customer@practicesoftwaretesting.com\",\"password\":\"welcome01\"}"
      },
      "postRequestScript": "var data = sp.response.json();\nsp.collectionVariables.set('authToken', data.access_token);",
      "description": "Stores the returned token in a collection variable for the next request.",
      "protocol": "http",
      "hookType": "before"
    },
    "use-token": {
      "id": "use-token",
      "name": "Use the extracted token",
      "method": "GET",
      "url": "https://api.practicesoftwaretesting.com/users/me",
      "headers": [
        {
          "key": "Authorization",
          "value": "Bearer {{authToken}}",
          "enabled": true
        }
      ],
      "params": [],
      "auth": {
        "type": "none"
      },
      "body": {
        "mode": "none"
      },
      "postRequestScript": "sp.test('status is 200', function () { sp.expect(sp.response.code).to.equal(200); });\nsp.test('profile is returned', function () { sp.expect(sp.response.json()).to.have.property('email'); });",
      "description": "Reuses {{authToken}} captured by the Login request.",
      "protocol": "http",
      "contract": {
        "statusCode": 200,
        "headers": [
          {
            "key": "content-type",
            "value": "application/json",
            "required": true
          }
        ],
        "bodySchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"id\": {\n      \"type\": \"string\"\n    },\n    \"provider\": {\n      \"type\": \"null\"\n    },\n    \"first_name\": {\n      \"type\": \"string\"\n    },\n    \"last_name\": {\n      \"type\": \"string\"\n    },\n    \"phone\": {\n      \"type\": \"null\"\n    },\n    \"dob\": {\n      \"type\": \"string\"\n    },\n    \"email\": {\n      \"type\": \"string\"\n    },\n    \"totp_enabled\": {\n      \"type\": \"boolean\"\n    },\n    \"created_at\": {\n      \"type\": \"string\"\n    },\n    \"address\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"street\": {\n          \"type\": \"string\"\n        },\n        \"house_number\": {\n          \"type\": \"null\"\n        },\n        \"city\": {\n          \"type\": \"string\"\n        },\n        \"state\": {\n          \"type\": \"null\"\n        },\n        \"country\": {\n          \"type\": \"string\"\n        },\n        \"postal_code\": {\n          \"type\": \"null\"\n        }\n      },\n      \"required\": [\n        \"street\",\n        \"city\",\n        \"country\"\n      ]\n    }\n  },\n  \"required\": [\n    \"id\",\n    \"first_name\",\n    \"last_name\",\n    \"dob\",\n    \"email\",\n    \"totp_enabled\",\n    \"created_at\",\n    \"address\"\n  ]\n}"
      }
    }
  },
  "collectionVariables": {
    "BASE_URL": "http://127.0.0.1:19200",
    "authToken": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..2mgLvMNGSNf_4FVDkmu52NX4YG9r9WAwyIrnYqGOwJY",
    "userId": "undefined"
  }
}