      },
      "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"quantidade\": {\n      \"type\": \"number\",\n      \"example\": 1\n    },\n    \"usuarios\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"nome\": {\n            \"type\": \"string\",\n            \"example\": \"Fulano da Silva\"\n          },\n          \"email\": {\n            \"type\": \"string\",\n            \"example\": \"beltrano@qa.com.br\"\n          },\n          \"password\": {\n            \"type\": \"string\",\n            \"example\": \"teste\"\n          },\n          \"administrador\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"true\",\n              \"false\"\n            ],\n            \"example\": \"true\"\n          },\n          \"_id\": {\n            \"type\": \"string\",\n            \"example\": \"0uxuPY0cbmQhpEz1\"\n          }\n        }\n      }\n    }\n  }\n}"
