      },
      "description": "Os carrinhos retornados são únicos por usuário",
      "meta": {
        "tags": [
          "Carrinhos"
        ]
      },
      "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"quantidade\": {\n      \"type\": \"number\",\n      \"example\": 1\n    },\n    \"carrinhos\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"produtos\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"idProduto\": {\n                  \"type\": \"string\"\n                },\n                \"quantidade\": {\n                  \"type\": \"integer\"\n                },\n                \"precoUnitario\": {\n                  \"type\": \"integer\"\n                }\n              },\n              \"example\": [\n                {\n                  \"idProduto\": \"BeeJh5lz3k6kSIzA\",\n                  \"quantidade\": 1,\n                  \"precoUnitario\": 470\n                },\n                {\n                  \"idProduto\": \"K6leHdftCeOJj8BJ\",\n                  \"quantidade\": 2,\n                  \"precoUnitario\": 5240\n                }\n              ]\n            }\n          },\n          \"precoTotal\": {\n            \"type\": \"integer\",\n            \"example\": 10950\n          },\n          \"quantidadeTotal\": {\n            \"type\": \"integer\",\n            \"example\": 3\n          },\n          \"idUsuario\": {\n            \"type\": \"string\",\n            \"example\": \"0uxuPY0cbmQhpEz1\"\n          },\n          \"_id\": {\n            \"type\": \"string\",\n            \"example\": \"aFOUqntef4iaOwWfg\"\n          }\n        }\n      }\n    }\n  }\n}"
    },
