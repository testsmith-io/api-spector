      "description": "Listar produtos cadastrados",
      "meta": {
        "tags": [
          "Produtos"
        ]
      },
      "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"quantidade\": {\n      \"type\": \"number\",\n      \"example\": 2\n    },\n    \"produtos\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"nome\": {\n            \"type\": \"string\"\n          },\n          \"preco\": {\n            \"type\": \"integer\"\n          },\n          \"descricao\": {\n            \"type\": \"string\"\n          },\n          \"quantidade\": {\n            \"type\": \"integer\"\n          },\n          \"_id\": {\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"example\": [\n        {\n          \"nome\": \"Logitech MX Vertical\",\n          \"preco\": 470,\n          \"descricao\": \"Mouse\",\n          \"quantidade\": 381,\n          \"_id\": \"BeeJh5lz3k6kSIzA\"\n        },\n        {\n          \"nome\": \"Samsung 60 polegadas\",\n          \"preco\": 5240,\n          \"descricao\": \"TV\",\n          \"quantidade\": 49977,\n          \"_id\": \"K6leHdftCeOJj8BJ\"\n        }\n      ]\n    }\n  }\n}"
    },
