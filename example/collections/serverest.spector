    "df7619ba-7f8d-4c98-a773-c3602dc875e2": {
      "id": "df7619ba-7f8d-4c98-a773-c3602dc875e2",
      "name": "Realizar login",
      "method": "POST",
      "url": "{{baseUrl}}/login",
      "headers": [],
      "params": [],
      "auth": {
        "type": "none"
      },
      "body": {
        "mode": "json",
        "json": "{\n  \"email\": \"fulano@qa.com\",\n  \"password\": \"teste\"\n}"
      },
      "description": "A duração do token retornado em authorization é de 600 segundos (10 minutos). Caso esteja expirado irá receber status code 401 (Unauthorized).\n",
      "meta": {
        "tags": [
          "Login"
        ]
      },
      "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"message\": {\n      \"type\": \"string\",\n      \"example\": \"Login realizado com sucesso\"\n    },\n    \"authorization\": {\n      \"type\": \"string\",\n      \"example\": \"Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6ImZ1bGFub0BxYS5jb20iLCJwYXNzd29yZCI6InRlc3RlIiwiaWF0IjoxNTg5NzU4NzQ2LCJleHAiOjE1ODk3Njg3NDZ9.B6TASHV8k9xBerz4NSeFBlAZGSDhZlqESt767M0567I\"\n    }\n  }\n}"
    },
