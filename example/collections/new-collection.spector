    "193fd94a-12a9-4037-ba87-23b247c96631": {
      "id": "193fd94a-12a9-4037-ba87-23b247c96631",
      "name": "status",
      "method": "GET",
      "url": "https://api.practicesoftwaretesting.com/status",
      "headers": [],
      "params": [],
      "auth": {
        "type": "none"
      },
      "body": {
        "mode": "graphql"
      },
      "postRequestScript": "const json = sp.response.json();\n\nsp.test('version equals \"5.0\"', function() {\n  sp.expect(json.version).to.equal(\"5.0\");\n});"
    },
    "804fc7a3-728d-479c-a37c-8f16a74ccf01": {
      "id": "804fc7a3-728d-479c-a37c-8f16a74ccf01",
      "name": "products",
      "method": "GET",
      "url": "https://api.practicesoftwaretesting.com/products",
      "headers": [],
      "params": [],
      "auth": {
        "type": "none"
      },
      "body": {
        "mode": "none"
      },
      "postRequestScript": "const json = sp.response.json();\n\nsp.test('version equals \"5.0\"', function() {\n  sp.expect(json.version).to.equal(\"5.0\");\n});\n\nsp.test('$.data[?(@.name==\"Combination Pliers\")].id equals \"01M522FSP1WG8CB2A7PYX0H1EY\"', function() {\n  const matches = sp.jsonPath(json, '$.data[?(@.name==\"Combination Pliers\")].id');\n  sp.expect(matches.length).to.be.above(0);\n  sp.expect(matches[0]).to.equal(\"01M522FSP1WG8CB2A7PYX0H1EY\");\n});"
    },
