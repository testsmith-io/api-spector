        "retain": false,
        "testScript": "sp.test('a temp reading arrives', () => {\n  const m = sp.messages.find(m => m.topic === 'sensors/temp');\n  sp.expect(m).to.exist;\n  sp.expect(m.json().c).to.be.a('number');\n});",
        "collectMs": 60000,
        "qos": 2
      }
    },
